#!/bin/bash
#
# Git hook: prepare-commit-msg
#
# Prompts to update changelog for version tag commits
#

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2
SHA1=$3

# Get the directory of this script
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$HOOK_DIR")"
SCRIPTS_DIR="$PROJECT_DIR/scripts"

# Colors
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Only run for regular commits (not merge, squash, etc.)
if [ -n "$COMMIT_SOURCE" ]; then
    exit 0
fi

# Check if this looks like a release commit
commit_msg=$(cat "$COMMIT_MSG_FILE")

# Detect version-related commits
if echo "$commit_msg" | grep -qiE '^(build|release|chore):.*(version|release|v[0-9]+\.[0-9]+\.[0-9]+)'; then
    echo -e "${YELLOW}⚠️  Detected a release/version commit${NC}"
    echo -e "${BLUE}ℹ️  Consider updating CHANGELOG.md before committing${NC}"
    echo ""
    echo "You can run:"
    echo "  ./scripts/generate_changelog.sh"
    echo ""
    echo "Or update CHANGELOG.md manually, then:"
    echo "  git add CHANGELOG.md"
    echo "  git commit --amend --no-edit"
    echo ""
    
    read -p "Would you like to generate changelog now? (y/n): " -n 1 -r
    echo ""
    
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        if [ -x "$SCRIPTS_DIR/generate_changelog.sh" ]; then
            "$SCRIPTS_DIR/generate_changelog.sh"
            
            # Check if changelog was updated
            if git diff --name-only | grep -q CHANGELOG.md; then
                echo ""
                read -p "Add CHANGELOG.md to this commit? (y/n): " -n 1 -r
                echo ""
                
                if [[ $REPLY =~ ^[Yy]$ ]]; then
                    git add CHANGELOG.md
                    echo -e "${BLUE}✓ CHANGELOG.md staged${NC}"
                fi
            fi
        else
            echo "Error: generate_changelog.sh not found or not executable"
        fi
    fi
fi

exit 0
